Fix — yeh line hata do:

csharp
using Microsoft.EntityFrameworkCore;
using AdminApp.Models;    // ❌ YEH LINE HATA DO

namespace AdminApp.Models   
{
    public class ApplicationDbContext : DbContext
    {
        public ApplicationDbContext(DbContextOptions<ApplicationDbContext> options)
            : base(options)
        {
        }
        public DbSet<User> Users { get; set; }
        public DbSet<Category> Categories { get; set; }
        public DbSet<Product> Products { get; set; }
        public DbSet<Cart> Carts { get; set; }
        public DbSet<Order> Orders { get; set; }
        public DbSet<OrderItem> OrderItems { get; set; }
    }
}
Final correct version:

csharp
using Microsoft.EntityFrameworkCore;

namespace AdminApp.Models
{
    public class ApplicationDbContext : DbContext
    {
        public ApplicationDbContext(DbContextOptions<ApplicationDbContext> options)
            : base(options)
        {
        }

        public DbSet<User> Users { get; set; }
        public DbSet<Category> Categories { get; set; }
        public DbSet<Product> Products { get; set; }
        public DbSet<Cart> Carts { get; set; }
        public DbSet<Order> Orders { get; set; }
        public DbSet<OrderItem> OrderItems { get; set; }
    }
}
Yeh waisa hi actual error nahi hota normally (self-referencing using ignored hota hai compiler mein) — but clean rakhna chahiye.

Bhai ab yeh karo:

using AdminApp.Models; line hata do
Build → Build Solution (Ctrl+Shift+B) karo
Error List check karo — agar koi aur error hai
Build successful hua kya ab? 🙂

