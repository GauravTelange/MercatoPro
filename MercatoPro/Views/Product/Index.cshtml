@model List<MercatoPro.Models.Product>
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<!-- Category Filter -->
<div class="container mt-4 mb-3">
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index"
           class="btn @(ViewBag.SelectedCategory == null ? "btn-dark" : "btn-outline-dark")">
            All
        </a>
        @foreach (var cat in ViewBag.Categories)
        {
            <a asp-action="Index" asp-route-categoryId="@cat.CategoryId"
               class="btn @(ViewBag.SelectedCategory == cat.CategoryId ? "btn-dark" : "btn-outline-dark")">
                @cat.CategoryName
            </a>
        }
    </div>
</div>

<!-- Products Grid -->
<div class="container mt-2">
    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/no-image.png" : product.ImageUrl)"
                         class="card-img-top"
                         style="height: 200px; object-fit: cover;"
                         alt="@product.ProductName" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.ProductName</h5>
                        <p class="card-text text-muted small">@product.Description</p>
                        <p class="card-text fw-bold">₹@product.Price</p>
                        <p class="card-text small">Category : @product.Category?.CategoryName</p>
                        <div class="mt-auto">
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <button type="submit" class="btn btn-success w-100">Add To Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div></div>