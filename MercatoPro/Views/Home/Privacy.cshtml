@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">🔒 Privacy Policy</h2>
        <p class="text-muted">Last updated: June 2026</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">1. Introduction</h5>
                    <p class="card-text">
                        Welcome to MercatoPro. We respect your privacy and are committed to protecting
                        the personal information you share with us while using our platform.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">2. Information We Collect</h5>
                    <p class="card-text">
                        When you register on MercatoPro, we collect basic information such as your
                        full name, email address, mobile number, and shipping address. This information
                        is used solely to create and manage your account, process orders, and improve
                        your shopping experience.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">3. How We Use Your Information</h5>
                    <p class="card-text">Your information is used to:</p>
                    <ul class="card-text">
                        <li>Create and manage your user account</li>
                        <li>Process and deliver your orders</li>
                        <li>Provide customer support</li>
                        <li>Improve our website and services</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">4. Data Storage and Security</h5>
                    <p class="card-text">
                        Your data is securely stored in our database. We take reasonable measures
                        to protect your information from unauthorized access, alteration, or disclosure.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">5. Cookies and Sessions</h5>
                    <p class="card-text">
                        MercatoPro uses session-based authentication to keep you logged in and to
                        manage your shopping cart. We do not use third-party tracking cookies.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">6. Third-Party Sharing</h5>
                    <p class="card-text">
                        We do not sell, trade, or share your personal information with third parties.
                        Your data stays within our platform and is used only for the purposes described above.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary">7. Your Rights</h5>
                    <p class="card-text">
                        You may update or delete your account information at any time by contacting us.
                    </p>
                </div>
            </div>

            <div class="card shadow-sm mb-4 border-0 bg-light">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary">8. Contact Us</h5>
                    <p class="card-text">
                        If you have any questions about this Privacy Policy, feel free to reach out at
                    </p>
                    <p class="fw-bold">support@mercatopro.com</p>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-3px);
    }
</style>