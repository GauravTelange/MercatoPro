@model List<AdminApp.Models.Category>;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<table class="table">
 <thead> 
    <tr>
        <th>Category</th>
        <th>Description</th>
        <th>Action</th>
    </tr>
 </thead>
 <tbody>
        @foreach( var item in Model){
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.Description</td>
                <td> 
                    <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger">Delete</a>

                </td>
                
            </tr>
        }
 </tbody>

</table>

<a asp-action="Add" class="btn btn-primary" >Add New Category</a>